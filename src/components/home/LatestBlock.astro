---
// src/components/home/LatestBlock.astro
import { getCollection } from "astro:content";
import { pieces } from "../../features/lab/pieces";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const latestPost = posts[0];

const latestPiece = [...pieces].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
)[0];

const entries = [
  latestPost && {
    kind: "Writing",
    title: latestPost.data.title,
    href: `/blog/${latestPost.id}`,
    date: latestPost.data.pubDate,
  },
  latestPiece && {
    kind: "Lab",
    title: latestPiece.title,
    href: `/lab/${latestPiece.slug}`,
    date: latestPiece.date,
  },
].filter((entry) => Boolean(entry)) as {
  kind: string;
  title: string;
  href: string;
  date: Date;
}[];

const dateFormatter = new Intl.DateTimeFormat("en-NZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

{
  (latestPost || latestPiece) && (
    <section
      class="max-w-[1360px] mx-auto px-4 md:px-10 pb-28"
      aria-labelledby="latest-heading"
    >
      <h2
        id="latest-heading"
        class="font-mono text-label text-base-content/70 pb-3 border-b border-base-300"
      >
        Latest
      </h2>
      <ul>
        {entries.map((entry, i) => (
          <li>
            <a
              href={entry.href}
              class="group grid grid-cols-[auto_1fr] md:grid-cols-[80px_80px_1fr_auto] gap-x-4 gap-y-2 items-baseline py-5 border-b border-base-300"
            >
              <span class="font-mono text-label text-primary">
                Fig. {String(i + 2).padStart(2, "0")}
              </span>
              <span class="font-mono text-label text-base-content/70">
                {entry.kind}
              </span>
              <span class="col-span-2 md:col-span-1 text-xl leading-snug font-medium tracking-[-0.01em] text-balance group-hover:text-primary transition-colors">
                {entry.title}
              </span>
              <time
                datetime={entry.date.toISOString()}
                class="text-sm text-base-content/70 whitespace-nowrap"
              >
                {dateFormatter.format(entry.date)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
