---
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string }[];
  required?: boolean;
  placeholder?: string;
  error?: string;
}

const { name, label, options, required = false, placeholder, error } = Astro.props;
---

<div class="space-y-1.5">
  <label for={name} class="block text-sm font-medium text-gray-400">
    {label}
    {required && <span class="text-gray-500">*</span>}
  </label>
  <select
    id={name}
    name={name}
    required={required}
    class="w-full rounded-md border border-gray-800 bg-gray-900/50 px-3 py-2 text-gray-100 placeholder-gray-500 focus:border-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-600"
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error ? `${name}-error` : undefined}
  >
    {placeholder && (
      <option value="" disabled selected>
        {placeholder}
      </option>
    )}
    {options.map((opt) => (
      <option value={opt.value}>{opt.label}</option>
    ))}
  </select>
  <p
    id={`${name}-error`}
    class={`text-sm text-red-400 ${error ? "" : "hidden"}`}
    role="alert"
  >
    {error ?? ""}
  </p>
</div>
