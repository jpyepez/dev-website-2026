---
// src/components/ui/Button.astro
interface Props {
  type?: "button" | "submit" | "reset";
  /** Optional id so callers can target this button, e.g. to disable it and swap its label while sending. */
  id?: string;
}

const { type = "button", id } = Astro.props as Props;
---

<button
  type={type}
  id={id}
  class="inline-flex items-center justify-center h-11 px-5 rounded-[2px] bg-primary text-primary-content text-sm font-medium hover:bg-[color-mix(in_oklch,var(--color-primary)_88%,white)] active:scale-[0.97] disabled:opacity-70 disabled:cursor-progress transition-[transform,background-color]"
>
  <slot />
</button>
