---
// src/components/ui/Input.astro
import { fieldClass, fieldErrorClass, fieldLabelClass } from "./field";

type InputType =
  | "text"
  | "email"
  | "password"
  | "number"
  | "tel"
  | "url"
  | "search";

interface Props {
  name: string;
  label: string;
  type?: InputType;
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  spellcheck?: boolean;
  error?: string;
}

const {
  name,
  label,
  type = "text",
  required = false,
  placeholder,
  autocomplete,
  spellcheck,
  error,
} = Astro.props as Props;
---

<div>
  <label for={name} class={fieldLabelClass}>{label}</label>
  <input
    id={name}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    autocomplete={autocomplete}
    spellcheck={spellcheck}
    class={fieldClass}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={`${name}-error`}
  />
  <p id={`${name}-error`} class={fieldErrorClass}>{error ?? ""}</p>
</div>
