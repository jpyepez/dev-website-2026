---
// src/components/ui/SocialLink.astro
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  class="inline-flex min-h-11 items-center border-b border-base-300 hover:text-primary hover:border-primary transition-colors"
  target="_blank"
  rel="noopener noreferrer"
>
  {label}
</a>
