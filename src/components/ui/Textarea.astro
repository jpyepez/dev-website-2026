---
// src/components/ui/Textarea.astro
import { fieldClass, fieldErrorClass, fieldLabelClass } from "./field";

interface Props {
  name: string;
  label: string;
  required?: boolean;
  rows?: number;
  placeholder?: string;
  error?: string;
}

const { name, label, required = false, rows = 4, placeholder, error } = Astro.props;
---

<div>
  <label for={name} class={fieldLabelClass}>{label}</label>
  <textarea
    id={name}
    name={name}
    required={required}
    rows={rows}
    placeholder={placeholder}
    class={`${fieldClass} h-auto min-h-40 py-3 leading-relaxed resize-y`}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={`${name}-error`}></textarea>
  <p id={`${name}-error`} class={fieldErrorClass}>{error ?? ""}</p>
</div>
