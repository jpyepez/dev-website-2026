---
// src/components/layout/Header.astro
import { getCollection } from "astro:content";
import { pieces } from "../../features/lab/pieces";

// Writing and Lab links only appear once their source has content, so an
// empty section is never advertised in the nav.
const hasPosts =
  (await getCollection("blog", ({ data }) => !data.draft)).length > 0;
const hasPieces = pieces.length > 0;
---

<header class="border-b border-base-200">
  <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
    <a
      href="/"
      class="text-base-content font-semibold hover:opacity-90 transition-opacity"
    >
      JP Yepez
    </a>
    <nav class="flex gap-6 text-sm uppercase tracking-wide">
      {
        hasPosts && (
          <a
            href="/blog"
            class="text-base-content/80 hover:text-primary transition-colors"
          >
            Writing
          </a>
        )
      }
      {
        hasPieces && (
          <a
            href="/lab"
            class="text-base-content/80 hover:text-primary transition-colors"
          >
            Lab
          </a>
        )
      }
      <a
        href="/uses"
        class="text-base-content/80 hover:text-primary transition-colors"
      >
        Uses</a
      >
      <a
        href="/contact"
        class="text-base-content/80 hover:text-primary transition-colors"
      >
        Contact</a
      >
    </nav>
  </div>
</header>
