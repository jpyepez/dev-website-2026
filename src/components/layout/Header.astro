---
// src/components/layout/Header.astro
import { getCollection } from "astro:content";
import { pieces } from "../../features/lab/pieces";

interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;

// Writing and Lab links only appear once their source has content, so an
// empty section is never advertised in the nav.
const hasPosts =
  (await getCollection("blog", ({ data }) => !data.draft)).length > 0;
const hasPieces = pieces.length > 0;

const links = [
  hasPosts && { href: "/blog", label: "Writing" },
  hasPieces && { href: "/lab", label: "Lab" },
  { href: "/uses", label: "Uses" },
  { href: "/contact", label: "Contact" },
].filter((link): link is { href: string; label: string } => Boolean(link));
---

<header>
  <div
    class:list={[
      "mx-auto px-4 md:px-10 py-3 flex justify-between items-center gap-4",
      wide ? "max-w-[1360px]" : "max-w-4xl",
    ]}
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-mono text-[13px] font-medium text-base-content hover:text-primary transition-colors"
    >
      JP Yepez
    </a>
    <nav class="flex gap-5 md:gap-6 text-[15px]" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="inline-flex min-h-11 items-center text-base-content/70 hover:text-primary transition-colors"
            aria-current={Astro.url.pathname.startsWith(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
