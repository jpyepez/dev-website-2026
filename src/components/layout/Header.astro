---
// src/components/layout/Header.astro
import { getCollection } from "astro:content";
import { pieces } from "../../features/lab/pieces";

export type Column = "home" | "prose" | "gallery";

interface Props {
  /** The page's content column, so the header's edges line up with it. */
  column?: Column;
}

const { column = "prose" } = Astro.props;

// Home pads inside its 1360px box; the other pages centre a column inside px-4 padding.
const columnClass: Record<Column, string> = {
  home: "max-w-[1360px] px-4 md:px-10",
  prose: "max-w-xl",
  gallery: "max-w-3xl",
};

// On the home page the h1 already says the name, so the wordmark would just repeat it
// directly above itself (and link to the page you're on).
const isHome = Astro.url.pathname === "/";

// Writing and Lab links only appear once their source has content, so an
// empty section is never advertised in the nav.
const hasPosts =
  (await getCollection("blog", ({ data }) => !data.draft)).length > 0;
const hasPieces = pieces.length > 0;

const links = [
  hasPosts && { href: "/blog", label: "Writing" },
  hasPieces && { href: "/lab", label: "Lab" },
  { href: "/uses", label: "Uses" },
  { href: "/contact", label: "Contact" },
].filter((link): link is { href: string; label: string } => Boolean(link));
---

<header class:list={[column !== "home" && "px-4"]}>
  <div
    class:list={[
      "mx-auto py-3 flex items-center gap-4",
      isHome ? "justify-end" : "justify-between",
      columnClass[column],
    ]}
  >
    {
      !isHome && (
        <a
          href="/"
          class="inline-flex min-h-11 items-center text-base font-semibold tracking-[-0.01em] text-base-content hover:text-primary transition-colors"
        >
          JP Yepez
        </a>
      )
    }
    <nav class="flex gap-5 md:gap-6 text-sm" aria-label="Primary">
      {
        links.map((link) => {
          const isCurrent = Astro.url.pathname.startsWith(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                "inline-flex min-h-11 items-center hover:text-primary transition-colors",
                isCurrent ? "text-base-content" : "text-base-content/70",
              ]}
              aria-current={isCurrent ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
