---
// src/components/layout/LabFrame.astro
import Base from "../../layouts/Base.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <main class="px-4 py-12 md:py-16 flex flex-col items-center">
    <article class="max-w-xl w-full">
      <h1 class="text-4xl md:text-5xl leading-[1.05] font-semibold tracking-[-0.035em] text-balance mb-8">
        {title}
      </h1>

      <section class="prose max-w-none mb-12">
        <slot name="writeup" />
      </section>

      <section class="not-prose">
        <slot name="demo" />
      </section>
    </article>
  </main>
</Base>
