---
interface Props {
  label: string;
  values: string[];
}
const { label, values } = Astro.props;
import Badge from "../../components/ui/Badge.astro";
---

<div class="flex flex-col sm:flex-row sm:gap-4 sm:items-start">
  <dt class="text-base-content/80 sm:w-32 shrink-0 pt-1.5 sm:pt-0">{label}</dt>
  <dd class="flex flex-wrap gap-2">
    {values.map((value) => (
      <Badge>{value}</Badge>
    ))}
  </dd>
</div>
