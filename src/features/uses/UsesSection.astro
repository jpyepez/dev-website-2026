---
// src/features/uses/UsesSection.astro
import UsesDefinitionItem from "./UsesDefinitionItem.astro";
import { pad, type ToolSection } from "./tools";

interface Props {
  section: ToolSection;
  index: number;
}
const { section, index } = Astro.props;
---

<section id={section.id} aria-labelledby={`${section.id}-heading`} class="scroll-mt-6" data-uses-section>
  <h2
    id={`${section.id}-heading`}
    class="flex items-baseline gap-3 pb-3 border-b border-base-300 font-mono text-label text-base-content/70"
  >
    <span class="text-primary tabular-nums">{pad(index + 1)}</span>
    {section.title}
  </h2>
  <dl>
    {section.items.map((item) => <UsesDefinitionItem {...item} />)}
  </dl>
</section>
