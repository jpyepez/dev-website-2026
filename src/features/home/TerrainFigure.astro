---
// src/features/home/TerrainFigure.astro
// The Terrain piece: terrain drawn in type, in a frame. Behaviour in terrain.ts.
---

<figure class="grid gap-3.5 m-0">
  <div
    class="relative min-h-[380px] lg:min-h-[min(72svh,720px)] rounded-[2px] border border-base-300 bg-base-200 cursor-crosshair select-none [-webkit-touch-callout:none]"
  >
    <canvas
      class="absolute inset-3.5 w-[calc(100%-28px)] h-[calc(100%-28px)] block font-mono touch-pan-y"
      role="img"
      aria-label="Terrain drawn with text characters. It slowly changes shape, rises under the pointer or a held finger, and ripples where you click or tap."
      data-terrain
    ></canvas>
    <span class="corner top-[-1px] left-[-1px] border-t border-l" aria-hidden="true"></span>
    <span class="corner top-[-1px] right-[-1px] border-t border-r" aria-hidden="true"></span>
    <span class="corner bottom-[-1px] left-[-1px] border-b border-l" aria-hidden="true"></span>
    <span class="corner bottom-[-1px] right-[-1px] border-b border-r" aria-hidden="true"></span>
  </div>
  <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span class="text-sm font-medium text-base-content">Terrain, set in type</span>
    <span class="font-mono text-label text-base-content/60">
      <span class="pointer-fine:inline hidden"><span class="text-primary">hover</span> raise · <span class="text-primary">click</span> ripple</span>
      <span class="pointer-fine:hidden"><span class="text-primary">hold</span> raise · <span class="text-primary">tap</span> ripple</span>
    </span>
  </figcaption>
</figure>

<style>
  .corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--color-primary);
  }
</style>

<script>
  import { mountTerrain } from "./terrain";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-terrain]");
  if (canvas) mountTerrain(canvas);
</script>
