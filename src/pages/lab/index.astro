---
// src/pages/lab/index.astro
import Base from "../../layouts/Base.astro";
import { pieces } from "../../features/lab/pieces";

const dateFormatter = new Intl.DateTimeFormat("en-NZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  column="gallery"
  noindex={pieces.length === 0}
  title="Lab — JP Yepez"
  description="Finished visual and interactive web pieces — Three.js, generative, data viz."
>
  <main class="px-4 py-12 md:py-16 flex flex-col items-center">
    <div class="max-w-3xl w-full">
      <h1 class="text-5xl md:text-6xl leading-[0.95] font-semibold tracking-[-0.045em] mb-4">Lab</h1>
      <p class="leading-relaxed mb-12">
        Finished visual and interactive web pieces — Three.js, generative, data
        viz.
      </p>

      {
        pieces.length === 0 ? (
          <p class="text-base-content/70 leading-relaxed">
            Nothing shipped yet — first piece lands soon.
          </p>
        ) : (
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {pieces.map((piece) => (
              <li>
                <a href={`/lab/${piece.slug}`} class="group block">
                  <img
                    src={piece.thumbnail}
                    alt=""
                    class="aspect-video w-full object-cover rounded-md mb-3"
                  />
                  <h2 class="text-xl font-semibold tracking-[-0.01em] group-hover:text-primary transition-colors">
                    {piece.title}
                  </h2>
                  <time
                    datetime={piece.date.toISOString()}
                    class="text-sm text-base-content/70"
                  >
                    {dateFormatter.format(piece.date)}
                  </time>
                  <p class="text-base-content/70 leading-relaxed mt-1">
                    {piece.summary}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</Base>
