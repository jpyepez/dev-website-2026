---
// src/pages/lab/index.astro
import Base from "../../layouts/Base.astro";
import { pieces } from "../../features/lab/pieces";
---

<Base
  title="Lab — JP Yepez"
  description="Finished visual and interactive web pieces — Three.js, generative, data viz."
>
  <main class="min-h-screen px-4 py-12 md:py-16 flex flex-col items-center">
    <div class="max-w-xl w-full">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-2">Lab</h1>
      <p class="text-base-content/90 leading-relaxed mb-12">
        Finished visual and interactive web pieces — Three.js, generative, data
        viz.
      </p>

      {
        pieces.length === 0 && (
          <p class="text-base-content/70 leading-relaxed">
            Nothing shipped yet — first piece lands soon.
          </p>
        )
      }
    </div>
  </main>
</Base>
