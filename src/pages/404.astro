---
// src/pages/404.astro
import Base from "../layouts/Base.astro";
---

<Base title="Not found — JP Yepez" noindex>
  <main class="px-4 py-12 md:py-16 flex flex-col items-center">
    <div class="max-w-xl w-full">
      <h1 class="text-5xl md:text-6xl leading-[0.95] font-semibold tracking-[-0.045em] mb-4">
        Not found
      </h1>
      <p class="leading-relaxed mb-8">
        There’s nothing at this address. It may have moved, or the link has a typo.
      </p>
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-mono text-label border-b border-base-300 hover:text-primary hover:border-primary transition-colors"
      >
        Go to the home page
      </a>
    </div>
  </main>
</Base>
