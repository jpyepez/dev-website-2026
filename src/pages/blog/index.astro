---
// src/pages/blog/index.astro
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const dateFormatter = new Intl.DateTimeFormat("en-NZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  noindex={posts.length === 0}
  title="Writing — JP Yepez"
  description="Long-form posts on senior frontend, mobile, and AI tooling."
>
  <main class="px-4 py-12 md:py-16 flex flex-col items-center">
    <div class="max-w-xl w-full">
      <h1 class="text-5xl md:text-6xl leading-[0.95] font-semibold tracking-[-0.045em] mb-4">
        Writing
      </h1>
      <p class="leading-relaxed mb-12">
        Long-form posts on senior frontend, mobile, and AI tooling.
      </p>

      {
        posts.length === 0 ? (
          <p class="text-base-content/70 leading-relaxed">
            Nothing published yet — first piece lands soon.
          </p>
        ) : (
          <ul class="space-y-8">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="group block">
                  <h2 class="text-xl font-semibold tracking-[-0.01em] group-hover:text-primary transition-colors">
                    {post.data.title}
                  </h2>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-sm text-base-content/70"
                  >
                    {dateFormatter.format(post.data.pubDate)}
                  </time>
                  <p class="text-base-content/70 leading-relaxed mt-1">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</Base>
