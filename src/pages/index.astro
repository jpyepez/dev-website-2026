---
// src/pages/index.astro
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
import LatestBlock from "../components/home/LatestBlock.astro";
import TerrainFigure from "../features/home/TerrainFigure.astro";
---

<Base title="JP Yepez — Senior Product Engineer" column="home">
  <main>
    <div
      class="max-w-[1360px] mx-auto px-4 md:px-10 pt-6 pb-16 grid gap-y-8 lg:grid-cols-[5fr_7fr] lg:grid-rows-[auto_1fr] lg:gap-x-[clamp(32px,5vw,72px)] lg:gap-y-0 [grid-template-areas:'text'_'fig'_'more'] lg:[grid-template-areas:'text_fig'_'more_fig']"
    >
      <section class="[grid-area:text]">
        <h1 class="text-5xl md:text-6xl lg:text-[clamp(48px,6.4vw,96px)] leading-[0.95] font-semibold tracking-[-0.045em] lg:-mt-[0.12em]">
          JP Yepez
        </h1>
        <p class="mt-3.5 font-mono text-label tracking-[0.02em] text-primary">
          Senior Product Engineer · Auckland
        </p>
        <p class="mt-10 text-[clamp(22px,2vw,28px)] leading-tight tracking-[-0.015em] font-medium text-balance max-w-[22em]">
          I build web and mobile products with AI agents. I care most about
          animation and interface detail.
        </p>
      </section>

      <div class="[grid-area:fig]">
        <TerrainFigure />
      </div>

      <section class="[grid-area:more] flex flex-col">
        <div class="mt-0 lg:mt-7 grid gap-[1.2em] text-base leading-relaxed text-base-content/70 max-w-[36em] text-pretty">
          <p>
            I’ve been writing React for twelve years. These days most of it goes
            through agents, with skills and rules I set up myself.
          </p>
          <p>
            React Native has been a regular part of my work for the last few
            years. The most recent app went from first commit to both app stores
            in six months.
          </p>
          <p>
            I came to software through creative tech and a PhD in Sonic Arts.
          </p>
        </div>
        <div class="mt-auto pt-10">
          <SocialLinks />
        </div>
      </section>
    </div>

    <LatestBlock />
  </main>
</Base>
