---
// src/pages/index.astro
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
---

<Base title="JP Yepez — Full-stack Engineer">
  <main class="min-h-screen flex items-center justify-center px-4 bg-gray-950">
    <div class="max-w-xl text-left">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
        I'm JP Yepez, full-stack engineer and frontend specialist
      </h1>

      <p class="text-gray-400 leading-relaxed mb-6">
        I've spent twelve years in React, focused on infrastructure, state
        management, and testing.
      </p>

      <p class="text-gray-400 leading-relaxed mb-6">
        I care about performance, accessibility, and responsiveness, and I build
        interfaces that are intuitive and fast.
      </p>

      <p class="text-gray-400 leading-relaxed mb-10">
        Mentoring teams and building with AI to ship faster without cutting
        corners.
      </p>

      <SocialLinks />

      <p class="mt-16 text-sm text-gray-600">More coming soon.</p>
    </div>
  </main>
</Base>
