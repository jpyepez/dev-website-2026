---
// src/pages/contact.astro
// Layout and values: docs/contact-design.md
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
import ContactForm from "../features/contact/ContactForm.astro";
---

<Base
  title="Contact — JP Yepez"
  description="Open to freelance and consulting work, especially with teams here in New Zealand."
  column="home"
>
  {/* Phones read intro → form → elsewhere; from lg, elsewhere moves under the intro (same grid areas as the home page). */}
  <main
    class="max-w-[1360px] mx-auto px-4 md:px-10 pt-10 md:pt-14 pb-28 grid gap-y-12 lg:grid-cols-[5fr_7fr] lg:grid-rows-[auto_1fr] lg:gap-x-[clamp(32px,5vw,72px)] lg:gap-y-0 [grid-template-areas:'text'_'form'_'more'] lg:[grid-template-areas:'text_form'_'more_form']"
  >
    <div class="[grid-area:text]">
      <h1 class="text-5xl md:text-6xl leading-[0.95] font-semibold tracking-[-0.045em]">
        Contact
      </h1>
      <p class="mt-3.5 font-mono text-label tracking-[0.02em] text-primary">
        Auckland, New Zealand
      </p>
      <p class="mt-10 text-[clamp(22px,2vw,28px)] leading-tight tracking-[-0.015em] font-medium text-balance max-w-[22em]">
        Open to freelance and consulting work, especially with teams here in
        New Zealand. Tell me a bit about what you’re working on.
      </p>
    </div>

    <div class="[grid-area:form] lg:pt-1">
      <ContactForm />
    </div>

    <div class="[grid-area:more] lg:mt-14 grid gap-3 content-start border-t border-base-300 pt-6 lg:border-0 lg:pt-0">
      <p class="font-mono text-label text-base-content/70">Elsewhere</p>
      <SocialLinks />
    </div>
  </main>
</Base>
