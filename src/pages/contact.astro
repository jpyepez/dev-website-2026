---
import Base from "../layouts/Base.astro";
import Input from "../components/ui/Input.astro";
import Select from "../components/ui/Select.astro";
import Textarea from "../components/ui/Textarea.astro";
import Button from "../components/ui/Button.astro";

const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY as string;

const topicOptions = [
  { value: "contact-freelance", label: "Contact / freelance" },
  { value: "consulting", label: "Consulting" },
  { value: "collaboration", label: "Collaboration" },
  { value: "just-saying-hi", label: "Just saying hi" },
];
---

<Base
  title="Contact — JP Yepez"
  description="Get in touch for freelance, consulting, or collaboration."
>
  <main class="px-4 py-12 md:py-16 flex flex-col items-center">
    <div class="max-w-xl w-full">
      <h1 class="text-5xl md:text-6xl leading-[0.95] font-semibold tracking-[-0.045em] mb-4">
        Contact
      </h1>
      <p class="leading-relaxed mb-12">
        Get in touch for freelance, consulting, or collaboration.
      </p>

      <form
        id="contact-form"
        class="space-y-4"
        data-access-key={accessKey}
        method="post"
      >
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          aria-hidden="true"
        />

        <Input
          name="name"
          label="Name"
          autocomplete="name"
          required
          placeholder="Your name"
        />

        <Input
          name="email"
          label="Email"
          type="email"
          autocomplete="email"
          required
          placeholder="you@example.com"
        />

        <Select
          name="subject"
          label="What’s this about?"
          options={topicOptions}
          required
          placeholder="Select…"
        />

        <Textarea
          name="message"
          label="Message"
          required
          rows={5}
          placeholder="Your message…"
        />

        <Button type="submit" id="contact-submit">Send message</Button>

        <div
          id="result"
          class="text-sm text-base-content/70"
          role="status"
          aria-live="polite"
        >
        </div>
      </form>
    </div>
  </main>
</Base>

<script>
  import { z } from "zod";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const resultEl = document.getElementById("result") as HTMLDivElement;

  const topicValues = [
    "contact-freelance",
    "consulting",
    "collaboration",
    "just-saying-hi",
  ] as const;
  const contactSchema = z.object({
    name: z.string().min(1, { error: "Name is required" }),
    email: z.email({ error: "Enter an email address like name@example.com" }),
    subject: z.enum(topicValues, { error: "Choose what this is about" }),
    message: z.string().min(1, { error: "Write a message before sending" }),
  });

  function clearFieldErrors() {
    const errors = form.querySelectorAll("[id$='-error']");
    errors.forEach((el) => {
      el.textContent = "";
    });
    form
      .querySelectorAll("[aria-invalid]")
      .forEach((el) => el.setAttribute("aria-invalid", "false"));
  }

  function setFieldError(name: string, message: string) {
    const input = form.querySelector(`[name="${name}"]`) as
      | HTMLInputElement
      | HTMLSelectElement
      | HTMLTextAreaElement
      | null;
    const errorEl = form.querySelector(`#${name}-error`) as HTMLElement | null;
    if (input) input.setAttribute("aria-invalid", "true");
    if (errorEl) {
      errorEl.textContent = message;
    }
  }

  function setResult(message: string, isError = false) {
    resultEl.textContent = message;
    resultEl.className = `text-sm ${isError ? "text-error" : "text-base-content/70"}`;
  }

  function showSuccessToast(message: string) {
    const container = document.getElementById("toast-container");
    if (!container) return;
    const alert = document.createElement("div");
    alert.className = "alert alert-success";
    const span = document.createElement("span");
    span.textContent = message;
    alert.appendChild(span);
    container.appendChild(alert);
    setTimeout(() => alert.remove(), 5000);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearFieldErrors();
    setResult("");

    const accessKey = form.dataset.accessKey;
    if (!accessKey) {
      setResult("Form is not configured. Please try again later.", true);
      return;
    }

    const formData = new FormData(form);
    const raw: Record<string, unknown> = {
      access_key: accessKey,
      name: formData.get("name") ?? "",
      email: formData.get("email") ?? "",
      subject: formData.get("subject") ?? "",
      message: formData.get("message") ?? "",
      botcheck: formData.get("botcheck") === "on",
    };

    const parsed = contactSchema.safeParse({
      name: raw.name,
      email: raw.email,
      subject: raw.subject || undefined,
      message: raw.message,
    });

    if (!parsed.success) {
      const issues = parsed.error.issues;
      issues.forEach((issue) => {
        const path = issue.path[0];
        if (typeof path === "string") {
          setFieldError(path, issue.message);
        }
      });
      setResult("Please fix the errors above.", true);
      return;
    }

    const submitBtn = document.getElementById("contact-submit");
    if (submitBtn) {
      submitBtn.classList.add("is-loading");
      (submitBtn as HTMLButtonElement).disabled = true;
    }

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(raw),
      });

      const data = (await response.json()) as {
        success?: boolean;
        message?: string;
      };

      if (response.ok && data.success) {
        form.reset();
        setResult("");
        showSuccessToast("Thanks, your message was sent.");
        setTimeout(() => {
          window.location.href = "/";
        }, 2500);
      } else {
        setResult(
          data.message ??
            "Your message wasn’t sent. Check your connection and try again.",
          true
        );
      }
    } catch {
      setResult(
        "Your message wasn’t sent. Check your connection and try again.",
        true
      );
    } finally {
      if (submitBtn) {
        submitBtn.classList.remove("is-loading");
        (submitBtn as HTMLButtonElement).disabled = false;
      }
    }
  });
</script>
