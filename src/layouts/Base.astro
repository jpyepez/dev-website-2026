---
// src/layouts/Base.astro
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import geistFont from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoFont from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header, { type Column } from "../components/layout/Header.astro";
import ToastContainer from "../components/layout/ToastContainer.astro";

interface Props {
  title: string;
  description?: string;
  /** The page's content column; the header lines up with it. */
  column?: Column;
  /** Keep the page out of search results, e.g. a section that has no content yet. */
  noindex?: boolean;
  /** Open Graph type: "article" for posts, "website" for everything else. */
  ogType?: "website" | "article";
}

const {
  title,
  description = "Full-stack engineer and frontend specialist. TypeScript, React, infrastructure, and testing.",
  column = "prose",
  noindex = false,
  ogType = "website",
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const ogImageAlt =
  "JP Yepez, Full-stack Engineer and Frontend Specialist, beside a terrain figure drawn in monospace characters.";
---

<!doctype html>
<html lang="en" class="dark" data-theme="night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04111c" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="JP Yepez — Writing"
      href={new URL("/blog/rss.xml", Astro.site)}
    />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoFont} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="JP Yepez" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body class="font-sans bg-base-100 text-base-content antialiased">
    <Header column={column} />
    <slot />
    <ToastContainer />
  </body>
</html>
